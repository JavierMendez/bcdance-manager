# PostgreSQL (Docker)
POSTGRES_USER=bcdance
POSTGRES_PASSWORD=bcdance
POSTGRES_DB=bcdance_manager
POSTGRES_PORT=5432

# App
APP_PORT=5173

# Production Docker (docker-compose.prod.yml uses port 5174 by default)
# APP_PORT=5174

# Required for adapter-node in production (must match BETTER_AUTH_URL)
# ORIGIN=http://localhost:5174

# Database URL
# Local app + Docker Postgres:
DATABASE_URL=postgresql://bcdance:bcdance@localhost:5432/bcdance_manager

# Docker app service (set automatically in docker-compose.yml):
# DATABASE_URL=postgresql://bcdance:bcdance@db:5432/bcdance_manager

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-secret-key
BETTER_AUTH_URL=http://localhost:5173

# Initial admin user (used by scripts/seed-admin.mjs)
ADMIN_EMAIL=admin@bcdance.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Administrador
