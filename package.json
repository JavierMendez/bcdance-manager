{
	"name": "bcdance-manager",
	"private": true,
	"version": "0.0.1",
	"packageManager": "pnpm@9.15.9",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:unit": "vitest run --project unit",
		"test:ui": "vitest run --project ui",
		"test:install": "playwright install chromium",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"docker:up": "docker compose up -d",
		"docker:down": "docker compose down",
		"docker:logs": "docker compose logs -f",
		"docker:db": "docker compose up -d db",
		"docker:prod:up": "docker compose -f docker-compose.prod.yml up -d --build",
		"docker:prod:down": "docker compose -f docker-compose.prod.yml down",
		"docker:prod:logs": "docker compose -f docker-compose.prod.yml logs -f",
		"seed:admin": "node --import dotenv/config scripts/seed-admin.mjs"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.2.8",
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^1.22.0",
		"@sveltejs/adapter-node": "^5.2.14",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "22",
		"@vitest/browser-playwright": "4.1.12",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"layerchart": "2.0.0-next.48",
		"playwright": "1.64.1",
		"shadcn-svelte": "^1.3.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.12",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "^1.6.23",
		"better-auth": "^1.6.23",
		"drizzle-orm": "^0.45.2",
		"mode-watcher": "^1.1.0",
		"postgres": "^3.4.9"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
